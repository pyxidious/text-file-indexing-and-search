{
  "dataset": "cranfield",
  "seed": 42,
  "sizes": [100, 200, 300],
  "main_size": 300,
  "query_split_seed": 42,
  "development_fraction": 0.2,
  "selection_rule": "max development macro F1@10; ties: Recall@10, MAP@10, declared strategy order",
  "strategies": [
    {"id": "or_original", "mode": "or", "minimum_should_match": 0.5},
    {"id": "or_stop", "mode": "or_stop", "minimum_should_match": 0.5},
    {"id": "msm_30", "mode": "msm", "minimum_should_match": 0.3},
    {"id": "msm_50", "mode": "msm", "minimum_should_match": 0.5},
    {"id": "msm_70", "mode": "msm", "minimum_should_match": 0.7},
    {"id": "and", "mode": "and", "minimum_should_match": 1.0}
  ],
  "relevance_threshold": 1,
  "repetitions": 5,
  "bm25": {"k1": 1.2, "b": 0.75}
}
